          [
            "What is your name?",
            "My name is... / I'm...",
            "Don't say: 'I call myself...'"
          ],
          [
            "Where are you from?",
            "I'm from + [Country / City]",
            "Don't omit 'from': 'I am Colombia' (X)"
          ],
          [
            "What do you do?",
            "I'm a / an + [Profession]",
            "Don't omit article: 'I am doctor' (X)"
          ],
          [
            "Nice to meet you!",
            "Nice to meet you too!",
            "Say 'too', never 'equally' or 'the same'"
          ]
        ]
