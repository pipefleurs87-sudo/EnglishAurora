          ["verb + to + verb", "decide, hope, learn, agree, plan, promise", "She decided to go."],
          ["preposition + -ing", "good at, afraid of, dream of", "He's good at drawing."],
          ["looking forward to + -ing", "fixed expression", "I'm looking forward to meeting you."]
        ]
      },
      "vocab_warmup": true
    },
