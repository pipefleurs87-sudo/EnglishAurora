  "fases": {
    "inicio": {
      "banner_diagnostico": {
        "opcion_a": "She working right now.",
        "opcion_b": "She is working right now.",
        "correcta": "b"
      },
      "definicion_pragmatica": "Use the present continuous for actions happening at this moment: am/is/are + verb-ing. Remember the spelling: run→running, dance→dancing, study→studying.",
      "tabla": {
        "titulo": "Present Continuous",
        "encabezados": ["Form", "Structure", "Example"],
        "filas": [
          ["Affirmative", "am/is/are + verb-ing", "She is cooking."],
          ["Negative", "am/is/are + not + verb-ing", "He isn't sleeping."],
          ["Question", "Am/Is/Are + subject + verb-ing?", "Are you reading?"],
          ["Spelling", "run→running, dance→dancing", "He is running."]
        ]
      },
      "vocab_warmup": true
    },
    "practica": {
      "ejercicios": [
        {"tipo": "multiple_choice", "etapa": "recognize", "pregunta": "Look! It ___ outside.", "opciones": ["rains", "is raining", "rain"], "respuesta": "is raining"},
        {"tipo": "multiple_choice", "etapa": "recognize", "pregunta": "They ___ lunch right now.", "opciones": ["eat", "are eating", "is eating"], "respuesta": "are eating"},
        {"tipo": "multiple_choice", "etapa": "recognize", "pregunta": "The -ing form of 'dance' is ___.", "opciones": ["danceing", "dansing", "dancing"], "respuesta": "dancing"},
        {"tipo": "true_false", "etapa": "recognize", "afirmacion": "We use the present continuous for actions happening now.", "respuesta": "true"},
        {"tipo": "true_false", "etapa": "recognize", "afirmacion": "'Run' becomes 'runing' in the -ing form.", "respuesta": "false"},
        {"tipo": "gap_fill", "etapa": "manipulate", "texto": "Ben ___ the guitar. (practice)", "respuesta": "is practicing"},
        {"tipo": "gap_fill", "etapa": "manipulate", "texto": "They ___ video games. (not/play)", "respuesta": "aren't playing"},
        {"tipo": "unscramble", "etapa": "manipulate", "palabras": ["is", "She", "a book", "reading", "."], "respuesta": "She is reading a book."},
        {"tipo": "correct_mistake", "etapa": "manipulate", "texto_con_error": "I am watch TV now.", "respuesta": "I am watching TV now."},
        {"tipo": "transformation", "etapa": "transform", "oracion_base": "He is cooking dinner.", "instruccion": "Make it negative.", "respuesta": "He isn't cooking dinner."},
        {"tipo": "transformation", "etapa": "transform", "oracion_base": "They are dancing.", "instruccion": "Turn it into a question.", "respuesta": "Are they dancing?"},
        {"tipo": "short_answer_production", "etapa": "transform", "pregunta": "What are you doing right now? (Answer with a full sentence.)", "respuesta": "I am studying English."}
      ]
    },
