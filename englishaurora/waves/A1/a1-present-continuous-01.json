  "cast_dialogue": [
    {"personaje": "Aurora", "linea": "Freeze the moment! What is happening right now? That is the magic of the present continuous."},
    {"personaje": "Sofía", "linea": "Shh! I am working right now. The client is calling in five minutes."},
    {"personaje": "Kenji", "linea": "Sorry! I am just looking for my headphones. Ben is playing music very loud."},
    {"personaje": "Ben", "linea": "I am not playing loud music — I am practicing the guitar!"},
    {"personaje": "Abuela Carmen", "linea": "Children, please! I am cooking soup, and the phone is ringing. Somebody is waiting!"}
