          ["Negative (I/you/we/they)", "don't + base verb", "I don't smoke."],
          ["Negative (he/she/it)", "doesn't + base verb", "He doesn't drive."],
          ["Question (I/you/we/they)", "Do + subject + base verb?", "Do you cook?"],
          ["Question (he/she/it)", "Does + subject + base verb?", "Does she study?"]
        ]
      },
      "vocab_warmup": true
    },
