  "cast_dialogue": [
    {"personaje": "Aurora", "linea": "Today we learn to say no and to ask — the two superpowers of 'to be'."},
    {"personaje": "Kenji", "linea": "Are you tired, Ben? You are very quiet today."},
    {"personaje": "Ben", "linea": "No, I'm not tired. I'm just hungry!"},
    {"personaje": "Sofía", "linea": "Is Abuela Carmen at home? She isn't here."},
    {"personaje": "Abuela Carmen", "linea": "Yes, I am here, dear! I am not late — you are early!"}
