        {"tipo": "true_false", "etapa": "recognize", "afirmacion": "Possessive adjectives always go before a noun.", "respuesta": "true"},
        {"tipo": "true_false", "etapa": "recognize", "afirmacion": "'Its' (possessive) and 'it's' (it is) mean the same.", "respuesta": "false"},
        {"tipo": "gap_fill", "etapa": "manipulate", "texto": "We do ___ homework after school. (we)", "respuesta": "our"},
