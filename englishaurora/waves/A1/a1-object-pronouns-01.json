  "cast_dialogue": [
    {"personaje": "Aurora", "linea": "The hero acts, but someone receives the action. Today you learn to speak of them without repeating their names."},
    {"personaje": "Sofía", "linea": "I love my grandmother. I visit her every Sunday."},
    {"personaje": "Ben", "linea": "And my dog follows me everywhere. I take him to the park daily."},
    {"personaje": "Kenji", "linea": "My friends help me with Spanish. I call them every week."},
    {"personaje": "Abuela Carmen", "linea": "My grandchildren hug me so hard! And I always tell them stories."}
  ],
