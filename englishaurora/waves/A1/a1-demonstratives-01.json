  "cast_dialogue": [
    {"personaje": "Aurora", "linea": "Point with your words! Near or far, one or many — four little words decide it all."},
    {"personaje": "Sofía", "linea": "This photo here is my family. And those pictures on the wall are my paintings."},
    {"personaje": "Ben", "linea": "Are these your glasses, Kenji? They are on the table."},
    {"personaje": "Kenji", "linea": "No, mine are in my backpack. And look — that bird in that tree is huge!"},
    {"personaje": "Abuela Carmen", "linea": "These candles are for the table, dear. And those flowers by the window are for you."}
  ],
