      "definicion_pragmatica": "Use 'this/these' for things near you and 'that/those' for things far away. 'This/that' go with singular; 'these/those' go with plural.",
      "tabla": {
        "titulo": "The 4 demonstratives",
        "encabezados": ["", "Near", "Far"],
        "filas": [
          ["Singular", "this (este)", "that (ese/aquel)"],
          ["Plural", "these (estos)", "those (esos/aquellos)"]
        ]
      },
      "vocab_warmup": true
    },
    "practica": {
      "ejercicios": [
        {"tipo": "multiple_choice", "etapa": "recognize", "pregunta": "___ is my pen. (in my hand)", "opciones": ["This", "That", "Those"], "respuesta": "This"},
        {"tipo": "multiple_choice", "etapa": "recognize", "pregunta": "___ mountains over there are huge.", "opciones": ["This", "These", "Those"], "respuesta": "Those"},
        {"tipo": "multiple_choice", "etapa": "recognize", "pregunta": "Are ___ your books? (on my desk)", "opciones": ["this", "these", "that"], "respuesta": "these"},
        {"tipo": "true_false", "etapa": "recognize", "afirmacion": "'These' is for plural things near you.", "respuesta": "true"},
        {"tipo": "true_false", "etapa": "recognize", "afirmacion": "'That' is for plural things far away.", "respuesta": "false"},
        {"tipo": "gap_fill", "etapa": "manipulate", "texto": "___ cloud over there looks like a dragon. (far, singular)", "respuesta": "That"},
        {"tipo": "gap_fill", "etapa": "manipulate", "texto": "___ candles here are for the table. (near, plural)", "respuesta": "These"},
        {"tipo": "unscramble", "etapa": "manipulate", "palabras": ["are", "Those", "flowers", "beautiful", "."], "respuesta": "Those flowers are beautiful."},
        {"tipo": "correct_mistake", "etapa": "manipulate", "texto_con_error": "This shoes are new.", "respuesta": "These shoes are new."},
        {"tipo": "transformation", "etapa": "transform", "oracion_base": "This is my watch.", "instruccion": "Make it plural.", "respuesta": "These are my watches."},
        {"tipo": "transformation", "etapa": "transform", "oracion_base": "That is a bird.", "instruccion": "Turn it into a question.", "respuesta": "Is that a bird?"},
        {"tipo": "short_answer_production", "etapa": "transform", "pregunta": "Point at something near you and describe it. (Use 'This is...')", "respuesta": "This is my computer."}
      ]
